{
  "name": "battito",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Battito - A complete music management and playback application based on a real doubly linked list.",
  "scripts": {
    "dev": "tsx Build/BuildClient.ts && tsx watch Server/Main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && tsx Build/BuildClient.ts && tsx Build/BuildServer.ts",
    "start": "node Dist/Server/Main.js",
    "test": "tsx --test Tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "node-gyp": "^12.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
